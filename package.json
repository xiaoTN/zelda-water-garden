{
  "name": "zelda-water-garden",
  "version": "1.13.2",
  "private": true,
  "description": "片刻：在水光、雪落与云间，留一点宁静",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/serve.cjs",
    "assets": "node scripts/generate-water-maps.cjs",
    "assets:snow": "node scripts/prepare-snow-textures.cjs",
    "assets:land": "node scripts/prepare-hyrule-background.cjs",
    "physics": "node scripts/bundle-physics.cjs",
    "audio": "node scripts/bundle-audio.cjs",
    "audio:snow": "node scripts/prepare-snow-audio.cjs",
    "audio:music": "node scripts/prepare-music.cjs && node scripts/bundle-audio.cjs",
    "test": "node --test tests/water.test.cjs tests/nature.test.cjs tests/nature-3d.test.cjs tests/music.test.cjs",
    "check": "node scripts/verify-package.cjs",
    "build": "node scripts/build.cjs",
    "test:browser": "node scripts/scene-transition-check.cjs && node scripts/music-browser-check.cjs && node scripts/audio-reentry-check.cjs && node scripts/render-recovery-check.cjs && node scripts/browser-check.cjs && node scripts/nature-browser-check.cjs && node scripts/displacement-browser-check.cjs",
    "test:nature-browser": "node scripts/nature-browser-check.cjs"
  },
  "dependencies": {
    "cannon-es": "0.20.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
